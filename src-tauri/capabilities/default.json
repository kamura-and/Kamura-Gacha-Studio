{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capabilities for the main application window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node-plugin-host",
          "cmd": "node",
          "args": [
            "../plugin-host/dist/index.js"
          ],
          "sidecar": false
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write"
  ]
}